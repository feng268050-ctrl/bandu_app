# Copy to .env and adjust for your machine.
# make emulator / make sync load this file automatically.

# Emulator AVD name (create with Android Studio or let scripts auto-create)
AVD=Bandu_Pixel_7_Pro_API_36
EMULATOR_PORT=5556
ADB_SERIAL=emulator-5556

# Optional emulator tuning
# EMULATOR_GPU=auto
# EMULATOR_SCALE=0.75
# EMULATOR_NO_AUDIO=1
# EMULATOR_HEADLESS=1   # no GUI window (make emulator defaults to visible window)
# EMULATOR_RECREATE=0

# Flutter API endpoint policy
# API_BASE_URL explicitly overrides the debug API target, including emulators.
# Leave it empty to use EMULATOR_API_BASE_URL for local emulator development.
API_BASE_URL=
EMULATOR_API_BASE_URL=http://10.0.2.2:3000/api/mobile/v1
DEVICE_API_BASE_URL=http://100.69.41.14:3000/api/mobile/v1
RELEASE_API_BASE_URL=https://aibandu.dpdns.org/api/mobile/v1
# 真机 debug 可使用 DEVICE_API_BASE_URL；production 固定使用上面的单域名地址。
# true 仅用于不访问服务端的静态 UI 调试。
BYPASS_AUTH=false

# Physical device example (use make install / make sync, not priv-app flow)
# ADB_SERIAL=9DLVS8DE7DQCCU9P
